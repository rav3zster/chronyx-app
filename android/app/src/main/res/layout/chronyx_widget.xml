<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="12dp"
    android:background="@drawable/widget_background">

    <!-- Header Area -->
    <LinearLayout
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="6dp">
        
        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="Chronyx Logo"
            android:layout_marginEnd="8dp"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chronyx Today"
                android:textColor="#F1F4FF"
                android:textStyle="bold"
                android:textSize="14sp"/>

            <TextView
                android:id="@+id/widget_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No active blueprint"
                android:textColor="#8B96B8"
                android:textSize="11sp"/>
        </LinearLayout>

        <!-- Quick Add Button -->
        <ImageButton
            android:id="@+id/widget_add_button"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_add"
            android:contentDescription="Add task"
            android:tint="#8B96B8"
            android:layout_marginEnd="4dp" />

        <!-- Refresh Button -->
        <ImageButton
            android:id="@+id/widget_refresh_button"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/stat_notify_sync"
            android:contentDescription="Refresh tasks"
            android:tint="#8B96B8" />
    </LinearLayout>

    <!-- Progress Bar (MS To-Do Style) -->
    <ProgressBar
        android:id="@+id/widget_progress_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_below="@id/widget_header"
        android:layout_marginBottom="8dp"
        android:max="100"
        android:progress="0"
        android:progressTint="#5B6EF5"
        android:progressBackgroundTint="#252D4A" />

    <View
        android:id="@+id/widget_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#252D4A"
        android:layout_below="@id/widget_progress_bar"
        android:layout_marginBottom="6dp"/>

    <!-- ListView for tasks -->
    <ListView
        android:id="@+id/widget_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/widget_divider"
        android:divider="@android:color/transparent"
        android:dividerHeight="4dp"/>

    <!-- Empty State View -->
    <TextView
        android:id="@+id/widget_empty_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/widget_divider"
        android:gravity="center"
        android:text="All caught up!\nNo tasks for today."
        android:textColor="#8B96B8"
        android:textSize="13sp"
        android:visibility="gone"/>

    <!-- Stats View -->
    <LinearLayout
        android:id="@+id/widget_stats_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/widget_divider"
        android:orientation="horizontal"
        android:weightSum="3"
        android:gravity="center_vertical"
        android:visibility="gone">
        
        <!-- Deep Work Stat -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            
            <TextView
                android:id="@+id/widget_stat_deep_work_val"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.0"
                android:textColor="#5B6EF5"
                android:textSize="22sp"
                android:textStyle="bold"/>
                
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Deep Work hrs"
                android:textColor="#8B96B8"
                android:textSize="10sp"
                android:gravity="center"/>
        </LinearLayout>

        <!-- Streak Stat -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            
            <TextView
                android:id="@+id/widget_stat_streak_val"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#F59E0B"
                android:textSize="22sp"
                android:textStyle="bold"/>
                
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Weekly Streak"
                android:textColor="#8B96B8"
                android:textSize="10sp"
                android:gravity="center"/>
        </LinearLayout>

        <!-- Completed Stat -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            
            <TextView
                android:id="@+id/widget_stat_completed_val"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#10B981"
                android:textSize="22sp"
                android:textStyle="bold"/>
                
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Completed"
                android:textColor="#8B96B8"
                android:textSize="10sp"
                android:gravity="center"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Focus View -->
    <LinearLayout
        android:id="@+id/widget_focus_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/widget_divider"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">
        
        <TextView
            android:id="@+id/widget_focus_task_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Study DBMS"
            android:textColor="#F1F4FF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:ellipsize="end"
            android:singleLine="true"/>
            
        <TextView
            android:id="@+id/widget_focus_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="24:59"
            android:textColor="#5B6EF5"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginVertical="4dp"/>
            
        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            
            <TextView
                android:id="@+id/widget_focus_pause_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PAUSE"
                android:textColor="#F59E0B"
                android:textStyle="bold"
                android:textSize="11sp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:id="@+id/widget_focus_resume_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RESUME"
                android:textColor="#10B981"
                android:textStyle="bold"
                android:textSize="11sp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/widget_focus_stop_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="STOP"
                android:textColor="#FF5370"
                android:textStyle="bold"
                android:textSize="11sp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:clickable="true"
                android:focusable="true"/>
        </LinearLayout>
    </LinearLayout>

</RelativeLayout>
